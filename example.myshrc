# ┌─────────────────────────────┐
# │       mysh Konfiguration    │
# └─────────────────────────────┘

# ── Prompt Farben (256-Color Index) ──
prompt_folder=17        # Farbe des Ordnernamens
prompt_time=237         # Farbe der Uhrzeit

# ── Git Farben ──
prompt_git_clean=34     # Farbe wenn alles committed (grün)
prompt_git_dirty=196    # Farbe wenn Änderungen vorhanden (rot)

# ── Startup Info ──
# 0 = nichts
# 1 = Logo sofort
# 2 = Logo fade-in
# 3 = Logo typewriter
# 4 = neofetch
startup_info=4

# ── Startup Animation ──
# 0 = keine Animation
# 1 = Sternenhimmel
# 2 = Boot-Sequenz
# 3 = Glitch Effekt
# 4 = Regen
startup_animation=1

# ── Farbe ──
# accent_color      = 256-Color für Animationen (0-255)
# accent_color_term = Terminal-Farbe für neofetch (0-7)
#   0=schwarz 1=rot 2=grün 3=gelb 4=blau 5=lila 6=cyan 7=weiß
accent_color=201
accent_color_term=5

# ── Aliases ──
alias ll="ls -la"
alias gs="git status"
alias gc="git commit"
alias ..="cd .."
